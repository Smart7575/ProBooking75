rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(trainerId) {
      return isSignedIn() && request.auth.uid == trainerId;
    }

    function isTrainerDocOwner() {
      return isSignedIn() && resource.data.trainerId == request.auth.uid;
    }

    function isTrainerRequestOwner() {
      return isSignedIn() && request.resource.data.trainerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, create, update: if true;
        allow delete: if isOwner(userId);
      }
    }

    match /trainers/{trainerId} {
      allow read, create, update: if true;
      allow delete: if isOwner(trainerId);

      match /{subcollection}/{docId} {
        allow read, create, update: if true;
        allow delete: if isOwner(trainerId);
      }
    }

    match /clients/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrainerDocOwner();
    }

    match /appointments/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrainerDocOwner();
    }

    match /availability/{docId} {
      allow read: if true;
      allow delete: if isTrainerDocOwner();
      allow create, update: if isTrainerRequestOwner();
    }

    match /exceptions/{docId} {
      allow read: if true;
      allow delete: if isTrainerDocOwner();
      allow create, update: if isTrainerRequestOwner();
    }

    match /services/{docId} {
      allow read: if true;
      allow delete: if isTrainerDocOwner();
      allow create, update: if isTrainerRequestOwner();
    }

    match /packages/{docId} {
      allow read: if true;
      allow delete: if isTrainerDocOwner();
      allow create, update: if isTrainerRequestOwner();
    }

    match /clientPackages/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrainerDocOwner();
    }

    match /messages/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrainerDocOwner();
    }

    match /invoices/{docId} {
      allow read, create, update: if true;
      allow delete: if isTrainerDocOwner();
    }
  }
}
